# ============================================================
# CivicTrack environment variables
# Copy this file to `.env` (server) and adjust the values.
# NEVER commit real secrets to Git.
# ============================================================

# ---------- Server (root: server/.env) ----------
# Port the Express API listens on
PORT=4000

# MongoDB connection string.
# Local development:  mongodb://127.0.0.1:27017/civictrack
# MongoDB Atlas:      mongodb+srv://ulaxmivardhan_db_user:mMW02zYG0nus61Sd@civictrack.uuwy7yx.mongodb.net/civictrack?retryWrites=true&w=majority&appName=CivicTrack
MONGODB_URI=mongodb+srv://ulaxmivardhan_db_user:<PASSWORD>@civictrack.uuwy7yx.mongodb.net/civictrack?retryWrites=true&w=majority&appName=CivicTrack

# Allowed frontend origin for CORS (Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign JWT access tokens.
# Use a long random string in production (e.g. `openssl rand -hex 48`).
JWT_SECRET=change-me-to-a-long-random-secret

# How long the auth cookie lives
JWT_EXPIRES_IN=7d

# Must be `true` in production (served over HTTPS). `false` for local dev.
COOKIE_SECURE=false

# Where uploaded citizen images are stored when Cloudinary is NOT configured.
UPLOAD_DIR=uploads

# OPTIONAL: Cloudinary image uploads.
# Leave empty to store uploads on local disk (the app still works).
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Seed fictional demonstration data on startup (development only).
# NEVER enable this against a production database.
SEED_ON_START=false

# ---------- Client (root: client/.env  -> also set in Vercel) ----------
# Base URL of the backend API.
# Local development:  http://localhost:4000/api
# Production:         https://civictrack-edf6.onrender.com/api
VITE_API_BASE_URL=http://localhost:4000/api
